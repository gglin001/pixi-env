#!/usr/bin/env bash
set -euo pipefail

show_sdk_path=false
for argument in "$@"; do
    if [[ "$argument" == "--show-sdk-path" ]]; then
        show_sdk_path=true
        break
    fi
done

if [[ "$show_sdk_path" != "true" ]]; then
    exec /usr/bin/xcrun "$@"
fi

default_sdk="$(/usr/bin/xcrun "$@")"
libsystem_tbd="$default_sdk/usr/lib/libSystem.tbd"
if [[ -f "$libsystem_tbd" ]] &&
    /usr/bin/sed -n '1,8p' "$libsystem_tbd" | /usr/bin/grep -q 'arm64-macos'; then
    printf '%s\n' "$default_sdk"
    exit 0
fi

sdk_directory="$(dirname "$default_sdk")"
compatible_sdk="$({
    for candidate in "$sdk_directory"/MacOSX*.sdk; do
        [[ -d "$candidate" ]] || continue
        candidate_libsystem="$candidate/usr/lib/libSystem.tbd"
        [[ -f "$candidate_libsystem" ]] || continue
        if /usr/bin/sed -n '1,8p' "$candidate_libsystem" |
            /usr/bin/grep -q 'arm64-macos'; then
            printf '%s\n' "$candidate"
        fi
    done
} | /usr/bin/sort -V | /usr/bin/tail -n 1)"

if [[ -z "$compatible_sdk" ]]; then
    echo "No installed macOS SDK exposes the arm64-macos libSystem target required by Zig 0.15." >&2
    exit 1
fi

printf '%s\n' "$compatible_sdk"
