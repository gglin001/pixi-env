+            "https://codeload.github.com/ocornut/imgui/tar.gz/refs/tags/v1.92.5-docking",
+            "N-V-__8AAEbOfQBnvcFcCX2W5z7tDaN8vaNZGamEQtNOe0UI",
+        ),
+    ] {
