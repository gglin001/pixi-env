 use std::env;
 use std::fs;
-use std::path::PathBuf;
+use std::path::{Path, PathBuf};
 use std::process::Command;
 
 fn zig_target(target: &str) -> &str {
@@ -29,6 +29,25 @@ fn env_bool(name: &str) -> Option<bool> {
     }
 }
 
+fn prefetch_zig_dependency(zig: &str, vendored_dir: &Path, archive: &str, expected_hash: &str) {
+    let output = Command::new(zig)
+        .arg("fetch")
+        .arg(archive)
+        .current_dir(vendored_dir)
+        .output()
+        .expect("failed to prefetch dependency for vendored libghostty-vt");
+    assert!(
+        output.status.success(),
+        "failed to prefetch dependency for vendored libghostty-vt: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert_eq!(
+        String::from_utf8_lossy(&output.stdout).trim(),
+        expected_hash,
+        "prefetched archive has an unexpected Zig package hash"
+    );
+}
+
 fn main() {
     println!("cargo:rerun-if-changed=build.rs");
     println!("cargo:rerun-if-changed=vendor/libghostty-vt.vendor.json");
@@ -58,6 +77,27 @@ fn main() {
