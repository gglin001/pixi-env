+// SPDX-License-Identifier: BSD-3-Clause
+//! The epoll interface used by vhost-user, implemented with native kqueue.
+//!
+//! Registrations are level-triggered by default, as on Linux. No helper threads
+//! or periodic polling are needed, and ready events are returned in batches.
+
+use std::collections::HashMap;
+use std::io;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::sync::Mutex;
+
+/// Operation on a descriptor registration.
+#[derive(Debug)]
+pub enum ControlOperation {
+    /// Register a new descriptor.
+    Add,
+    /// Replace an existing registration.
+    Modify,
+    /// Remove an existing registration.
+    Delete,
+}
+
+bitflags::bitflags! {
+    /// Readiness and registration flags, using the Linux bit assignments.
+    pub struct EventSet: u32 {
+        /// Data can be read.
+        const IN = 0x001;
+        /// Exceptional data, unsupported on this backend.
+        const PRIORITY = 0x002;
+        /// Data can be written.
+        const OUT = 0x004;
+        /// An error occurred.
+        const ERROR = 0x008;
+        /// The peer closed the descriptor.
+        const HANG_UP = 0x010;
+        /// The peer closed its write side.
+        const READ_HANG_UP = 0x2000;
+        /// Exclusive wakeups, unsupported on this backend.
+        const EXCLUSIVE = 1 << 28;
+        /// Suspend inhibition, unsupported on this backend.
+        const WAKE_UP = 1 << 29;
+        /// Disable the registration after one event.
+        const ONE_SHOT = 1 << 30;
+        /// Report transitions instead of persistent readiness.
+        const EDGE_TRIGGERED = 1 << 31;
+    }
+}
+
+/// A readiness event and its caller-supplied token.
+#[derive(Debug, Default, Copy, Clone)]
+pub struct EpollEvent {
+    /// Readiness bits.
+    pub events: u32,
+    data: u64,
+}
+
+impl EpollEvent {
+    /// Construct an event.
+    pub fn new(events: EventSet, data: u64) -> Self {
+        Self {
+            events: events.bits(),
+            data,
+        }
+    }
+    /// Return readiness bits.
+    pub fn events(&self) -> u32 {
+        self.events
+    }
+    /// Return the readiness set.
+    pub fn event_set(&self) -> EventSet {
+        EventSet::from_bits_truncate(self.events)
+    }
+    /// Return the caller-supplied token.
+    pub fn data(&self) -> u64 {
+        self.data
+    }
+    /// Interpret the token as a descriptor.
+    pub fn fd(&self) -> RawFd {
+        self.data as RawFd
+    }
+}
+
+/// Native kqueue with the epoll API needed by vhost-user-backend.
+#[derive(Debug)]
+pub struct Epoll {
+    fd: OwnedFd,
+    registrations: Mutex<HashMap<RawFd, EventSet>>,
+}
+
+impl Epoll {
+    /// Create a queue with close-on-exec set.
+    pub fn new() -> io::Result<Self> {
+        // SAFETY: kqueue has no pointer arguments and returns a newly owned fd.
+        let raw = unsafe { libc::kqueue() };
+        if raw < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: raw is a newly allocated descriptor owned by this instance.
+        let fd = unsafe { OwnedFd::from_raw_fd(raw) };
+        // SAFETY: fd is valid and F_SETFD takes an integer argument.
+        if unsafe { libc::fcntl(raw, libc::F_SETFD, libc::FD_CLOEXEC) } < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self {
+            fd,
+            registrations: Mutex::new(HashMap::new()),
+        })
+    }
+
+    /// Add, replace, or remove a descriptor registration.
+    pub fn ctl(&self, operation: ControlOperation, fd: RawFd, event: EpollEvent) -> io::Result<()> {
+        let requested = event.event_set();
+        if requested.intersects(EventSet::PRIORITY | EventSet::EXCLUSIVE | EventSet::WAKE_UP) {
+            return Err(io::Error::from_raw_os_error(libc::ENOTSUP));
+        }
+        let mut registrations = self.registrations.lock().unwrap();
+        let previous = registrations.get(&fd).copied();
+        match operation {
+            ControlOperation::Add if previous.is_some() => {
+                return Err(io::Error::from_raw_os_error(libc::EEXIST))
+            }
+            ControlOperation::Modify | ControlOperation::Delete if previous.is_none() => {
+                return Err(io::Error::from_raw_os_error(libc::ENOENT))
+            }
+            _ => {}
+        }
+        let desired = if matches!(operation, ControlOperation::Delete) {
+            EventSet::empty()
+        } else {
+            requested
+        };
+        for (interest, filter) in [
+            (EventSet::IN, libc::EVFILT_READ),
+            (EventSet::OUT, libc::EVFILT_WRITE),
+        ] {
+            let flags = if desired.contains(interest) {
+                libc::EV_ADD
+                    | libc::EV_ENABLE
+                    | if desired.contains(EventSet::EDGE_TRIGGERED) {
+                        libc::EV_CLEAR
+                    } else {
+                        0
+                    }
+                    | if desired.contains(EventSet::ONE_SHOT) {
+                        libc::EV_DISPATCH
+                    } else {
+                        0
+                    }
+            } else if previous.is_some_and(|old| old.contains(interest)) {
+                libc::EV_DELETE
+            } else {
+                continue;
+            };
+            let change = libc::kevent {
+                ident: fd as libc::uintptr_t,
+                filter,
+                flags,
+                fflags: 0,
+                data: 0,
+                udata: event.data as usize as *mut libc::c_void,
+            };
+            // SAFETY: change references one initialized event; no output array is supplied.
+            if unsafe {
+                libc::kevent(
+                    self.fd.as_raw_fd(),
+                    &change,
+                    1,
+                    std::ptr::null_mut(),
+                    0,
+                    std::ptr::null(),
+                )
+            } < 0
+            {
+                return Err(io::Error::last_os_error());
+            }
+        }
+        if matches!(operation, ControlOperation::Delete) {
+            registrations.remove(&fd);
+        } else {
+            registrations.insert(fd, desired);
+        }
+        Ok(())
+    }
+
+    /// Wait for readiness, with a timeout in milliseconds or -1 for no timeout.
+    pub fn wait(&self, timeout: i32, events: &mut [EpollEvent]) -> io::Result<usize> {
+        if events.is_empty() {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        // A fixed stack buffer avoids allocation on the virtqueue hot path.
+        // SAFETY: a zeroed kevent is valid as an output-only event record.
+        let mut ready: [libc::kevent; 128] = unsafe { std::mem::zeroed() };
+        let limit = events.len().min(ready.len());
+        let duration = libc::timespec {
+            tv_sec: (timeout.max(0) / 1000) as libc::time_t,
+            tv_nsec: ((timeout.max(0) % 1000) * 1_000_000) as libc::c_long,
+        };
+        let deadline = if timeout < 0 {
+            std::ptr::null()
+        } else {
+            &duration
+        };
+        // SAFETY: ready contains limit writable records; deadline is null or valid.
+        let count = unsafe {
+            libc::kevent(
+                self.fd.as_raw_fd(),
+                std::ptr::null(),
+                0,
+                ready.as_mut_ptr(),
+                limit as i32,
+                deadline,
+            )
+        };
+        if count < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        for (output, input) in events.iter_mut().zip(ready.iter()).take(count as usize) {
+            let mut flags = if input.filter == libc::EVFILT_READ {
+                EventSet::IN
+            } else {
+                EventSet::OUT
+            };
+            if input.flags & libc::EV_EOF != 0 {
+                flags |= EventSet::HANG_UP;
+            }
+            if input.flags & libc::EV_ERROR != 0 {
+                flags |= EventSet::ERROR;
+            }
+            *output = EpollEvent::new(flags, input.udata as usize as u64);
+        }
+        Ok(count as usize)
+    }
+}
+
+impl AsRawFd for Epoll {
+    fn as_raw_fd(&self) -> RawFd {
+        self.fd.as_raw_fd()
+    }
+}
