+#![cfg(target_os = "macos")]
+
+use std::os::fd::AsRawFd;
+use std::sync::Arc;
+use std::time::Duration;
+use vmm_sys_util::epoll::{ControlOperation, Epoll, EpollEvent, EventSet};
+use vmm_sys_util::event::{new_event_consumer_and_notifier, EventFlag};
+
+#[test]
+fn pipe_notifications_are_batched_and_level_triggered() {
+    let (consumer, notifier) =
+        new_event_consumer_and_notifier(EventFlag::NONBLOCK | EventFlag::CLOEXEC).unwrap();
+    let poller = Epoll::new().unwrap();
+    poller
+        .ctl(
+            ControlOperation::Add,
+            consumer.as_raw_fd(),
+            EpollEvent::new(EventSet::IN, 17),
+        )
+        .unwrap();
+    // Overflow a nonblocking pipe; notification coalescing must avoid errors.
+    for _ in 0..100_000 {
+        notifier.notify().unwrap();
+    }
+    let mut events = [EpollEvent::default(); 8];
+    let mut wakes = 0;
+    while poller.wait(0, &mut events).unwrap() != 0 {
+        assert_eq!(events[0].data(), 17);
+        assert_eq!(events[0].event_set(), EventSet::IN);
+        consumer.consume().unwrap();
+        wakes += 1;
+        assert!(wakes < 100);
+    }
+    assert!(wakes > 0);
+    notifier.notify().unwrap();
+    assert_eq!(poller.wait(100, &mut events).unwrap(), 1);
+    consumer.consume().unwrap();
+    assert_eq!(poller.wait(0, &mut events).unwrap(), 0);
+}
+
+#[test]
+fn blocking_wait_wakes_after_concurrent_registration() {
+    let poller = Arc::new(Epoll::new().unwrap());
+    let waiter = poller.clone();
+    let thread = std::thread::spawn(move || {
+        let mut events = [EpollEvent::default(); 1];
+        assert_eq!(waiter.wait(1000, &mut events).unwrap(), 1);
+        assert_eq!(events[0].data(), 123);
+    });
+    std::thread::sleep(Duration::from_millis(20));
+    let (consumer, notifier) = new_event_consumer_and_notifier(EventFlag::NONBLOCK).unwrap();
+    poller
+        .ctl(
+            ControlOperation::Add,
+            consumer.as_raw_fd(),
+            EpollEvent::new(EventSet::IN, 123),
+        )
+        .unwrap();
+    notifier.notify().unwrap();
+    thread.join().unwrap();
+}
+
+#[test]
+fn registrations_can_be_modified_removed_and_reused() {
+    let poller = Epoll::new().unwrap();
+    let (consumer, notifier) = new_event_consumer_and_notifier(EventFlag::NONBLOCK).unwrap();
+    let event = EpollEvent::new(EventSet::IN, 7);
+    poller
+        .ctl(ControlOperation::Add, consumer.as_raw_fd(), event)
+        .unwrap();
+    assert_eq!(
+        poller
+            .ctl(ControlOperation::Add, consumer.as_raw_fd(), event)
+            .unwrap_err()
+            .raw_os_error(),
+        Some(libc::EEXIST)
+    );
+    poller
+        .ctl(
+            ControlOperation::Modify,
+            consumer.as_raw_fd(),
+            EpollEvent::new(EventSet::IN, 9),
+        )
+        .unwrap();
+    notifier.notify().unwrap();
+    let mut events = [EpollEvent::default(); 1];
+    assert_eq!(poller.wait(0, &mut events).unwrap(), 1);
+    assert_eq!(events[0].data(), 9);
+    poller
+        .ctl(ControlOperation::Delete, consumer.as_raw_fd(), event)
+        .unwrap();
+    assert_eq!(poller.wait(0, &mut events).unwrap(), 0);
+    poller
+        .ctl(ControlOperation::Add, consumer.as_raw_fd(), event)
+        .unwrap();
+    assert_eq!(poller.wait(0, &mut events).unwrap(), 1);
+}
