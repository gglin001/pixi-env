+// SPDX-License-Identifier: BSD-3-Clause
+// Buffered Darwin directory streams. Keep telldir cookies for the lifetime of
+// an open directory instead of rescanning and allocating the entire directory
+// for every FUSE page. Different handles have independent cursors.
+use crate::filesystem::{DirEntry, DirectoryIterator};
+use std::ffi::{CStr, CString};
+use std::io;
+use std::os::unix::io::AsRawFd;
+
+pub struct DirStream(*mut libc::DIR);
+
+// All access requires &mut self and the owning HandleData protects it with a
+// Mutex. Darwin permits moving a directory stream between threads.
+unsafe impl Send for DirStream {}
+
+impl DirStream {
+    pub fn new(dir: &impl AsRawFd) -> io::Result<Self> {
+        // openat, rather than dup, gives the stream an independent file offset.
+        let fd = unsafe {
+            libc::openat(
+                dir.as_raw_fd(),
+                b".\0".as_ptr().cast(),
+                libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let stream = unsafe { libc::fdopendir(fd) };
+        if stream.is_null() {
+            let err = io::Error::last_os_error();
+            unsafe {
+                libc::close(fd);
+            }
+            return Err(err);
+        }
+        Ok(Self(stream))
+    }
+
+    fn seek(&mut self, offset: u64) -> io::Result<()> {
+        if offset > libc::c_long::MAX as u64 {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        // Cookie zero always starts a fresh enumeration, including host edits.
+        unsafe {
+            if offset == 0 {
+                libc::rewinddir(self.0);
+            } else {
+                libc::seekdir(self.0, offset as libc::c_long);
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Drop for DirStream {
+    fn drop(&mut self) {
+        unsafe {
+            libc::closedir(self.0);
+        }
+    }
+}
+
+struct Entry {
+    ino: u64,
+    offset: u64,
+    type_: u32,
+    name: CString,
+}
+
+#[derive(Default)]
+pub struct ReadDir<P> {
+    entries: Vec<Entry>,
+    current: usize,
+    _buffer: std::marker::PhantomData<P>,
+}
+
+impl<P: AsRef<[u8]>> ReadDir<P> {
+    pub fn from_stream(stream: &mut DirStream, offset: u64, buf: P) -> io::Result<Self> {
+        stream.seek(offset)?;
+        Self::read_batch(stream, buf)
+    }
+
+    fn read_batch(stream: &mut DirStream, buf: P) -> io::Result<Self> {
+        let mut entries = Vec::new();
+        // Bound both allocation and work independently of directory size.
+        let limit = buf.as_ref().len().clamp(4096, 64 * 1024);
+        let mut bytes = 0;
+        while bytes < limit {
+            unsafe {
+                *libc::__error() = 0;
+            }
+            let ent = unsafe { libc::readdir(stream.0) };
+            if ent.is_null() {
+                let err = io::Error::last_os_error();
+                if err.raw_os_error() != Some(0) {
+                    return Err(err);
+                }
+                break;
+            }
+            // readdir's pointer is valid until the next call on this stream.
+            let ent = unsafe { &*ent };
+            let name = unsafe { CStr::from_ptr(ent.d_name.as_ptr()) }.to_owned();
+            let offset = unsafe { libc::telldir(stream.0) };
+            if offset < 0 {
+                return Err(io::Error::last_os_error());
+            }
+            bytes += 24 + name.as_bytes_with_nul().len();
+            entries.push(Entry {
+                ino: ent.d_ino,
+                offset: offset as u64,
+                type_: ent.d_type as u32,
+                name,
+            });
+        }
+        Ok(Self {
+            entries,
+            current: 0,
+            _buffer: std::marker::PhantomData,
+        })
+    }
+
+    pub fn new(dir: &impl AsRawFd, offset: u64, buf: P) -> io::Result<Self> {
+        let mut stream = DirStream::new(dir)?;
+        // This entrypoint is for non-persistent internal traversals only.
+        if offset != 0 {
+            return Err(io::Error::from_raw_os_error(libc::EOPNOTSUPP));
+        }
+        Self::read_batch(&mut stream, buf)
+    }
+
+    /// # Safety
+    /// The directory must be valid. Migration traversal is unsupported on Darwin.
+    pub unsafe fn new_no_seek(_dir: &impl AsRawFd, _buf: P) -> io::Result<Self> {
+        Err(io::Error::from_raw_os_error(libc::EOPNOTSUPP))
+    }
+}
+
+impl<P> ReadDir<P> {
+    pub fn remaining(&self) -> usize {
+        self.entries.len() - self.current
+    }
+}
+
+impl<P> DirectoryIterator for ReadDir<P> {
+    fn next(&mut self) -> Option<DirEntry<'_>> {
+        let entry = self.entries.get(self.current)?;
+        self.current += 1;
+        Some(DirEntry {
+            ino: entry.ino,
+            offset: entry.offset,
+            type_: entry.type_,
+            name: &entry.name,
+        })
+    }
+}
