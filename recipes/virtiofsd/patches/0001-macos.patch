+#[test]
+fn append_then_positioned_write_preserves_offsets() {
+    let (dir, fs) = setup();
+    let path = dir.path().join("append");
+    fs::write(&path, b"before").unwrap();
+    let (inode, handle) = open_rdwr(&fs, "append");
+    let mut input = VecReader {
+        data: b"after".to_vec(),
+        pos: 0,
+    };
+    fs.write(
+        current_ctx(),
+        inode,
+        handle,
+        &mut input,
+        5,
+        0,
+        None,
+        false,
+        false,
+        0o2000,
+    )
+    .unwrap();
+    assert_eq!(fs::read(&path).unwrap(), b"beforeafter");
+    let mut input = VecReader {
+        data: b"B".to_vec(),
+        pos: 0,
+    };
+    fs.write(
+        current_ctx(),
+        inode,
+        handle,
+        &mut input,
+        1,
+        0,
+        None,
+        false,
+        false,
+        0,
+    )
+    .unwrap();
+    assert_eq!(fs::read(&path).unwrap(), b"Beforeafter");
+    // Unsupported preallocation must leave file contents and length intact.
+    let err = fs
+        .fallocate(current_ctx(), inode, handle, 0, 1024 * 1024, 0)
+        .unwrap_err();
+    assert_eq!(err.raw_os_error(), Some(libc::EOPNOTSUPP));
+    assert_eq!(fs::read(&path).unwrap(), b"Beforeafter");
+}
