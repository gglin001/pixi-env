+            path.as_ptr(),
+            (flags & !(libc::O_TRUNC | libc::O_CREAT)) | libc::O_NOFOLLOW | libc::O_NONBLOCK,
+        )
+    };
+    if new_fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let file = unsafe { File::from_raw_fd(new_fd) };
+    let mut after: libc::stat = unsafe { std::mem::zeroed() };
+    if unsafe { libc::fstat(new_fd, &mut after) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if before.st_dev != after.st_dev
+        || before.st_ino != after.st_ino
+        || before.st_mode & libc::S_IFMT != after.st_mode & libc::S_IFMT
+    {
+        return Err(io::Error::from_raw_os_error(libc::ESTALE));
+    }
+    if flags & libc::O_TRUNC != 0 && unsafe { libc::ftruncate(new_fd, 0) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(file)
+}
