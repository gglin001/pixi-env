+    let dir = TempDir::new().unwrap();
+    let path = dir.path().join("protected");
+    fs::write(&path, b"keep me").unwrap();
+    let ro = PassthroughFsRo::new(Config {
+        root_dir: dir.path().to_str().unwrap().to_owned(),
+        ..Default::default()
+    })
+    .unwrap();
+    ro.init(FsOptions::empty()).unwrap();
+    let inode = ro
+        .lookup(current_ctx(), ROOT_ID, &cstr("protected"))
+        .unwrap()
+        .inode;
